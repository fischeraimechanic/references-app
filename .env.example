# Oracle Object Storage Configuration
# Get these from Oracle Cloud Console:
# 1. Object Storage → Create bucket
# 2. User Settings → Customer Secret Keys → Generate Key
# 3. Bucket details → Namespace (copy the namespace string)

# Format: https://{namespace}.compat.objectstorage.{region}.oraclecloud.com
# Example: https://mytenant.compat.objectstorage.us-ashburn-1.oraclecloud.com
OCI_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com

# Your bucket name
OCI_BUCKET=your-bucket-name

# From Customer Secret Key (Access Key / Secret Key)
OCI_ACCESS_KEY=your-access-key
OCI_SECRET_KEY=your-secret-key

# Public URL for videos (replace with your values)
# Format: https://objectstorage.{region}.oraclecloud.com/n/{namespace}/b/{bucket}/o/
# Example: https://objectstorage.us-ashburn-1.oraclecloud.com/n/mytenant/b/references/o/
PUBLIC_R2_PUBLIC_URL=https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o/